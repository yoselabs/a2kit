# Required for full Google mode (ADR 0011 recipe).
# FERNET_KEY: a urlsafe-base64-encoded 32-byte key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SIGNING_KEY=
FERNET_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# Workspace root — per-user dirs are created inside.
WORKSPACE_ROOT=/tmp/mcp-google-auth-workspaces

# OAuth token cache path. Default is ~/.local/share/mcp-google-auth-example/oauth-cache.
TOKEN_CACHE_PATH=

# Bearer-only mode (smoke test / DCR-incompatible clients).
# When set AND GOOGLE_CLIENT_ID is unset, the server skips OAuth and
# verifies static tokens. Shape: {"<bearer>": {"client_id": ..., "scopes": [...], "claims": {"email": ...}}}.
STATIC_TOKENS_JSON=
